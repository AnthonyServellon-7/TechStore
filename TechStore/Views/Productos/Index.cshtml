@model IEnumerable<TechStore.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    ViewData["MostrarAcciones"] = true;
}

<div class="container my-4">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold text-primary">Catálogo de Productos</h1>
        <p class="lead text-muted">Explora los últimos dispositivos y accesorios tecnológicos</p>
    </div>

    @if (TempData["SuccessMessage"] is string mensaje)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted">@Model.Count() producto(s) registrado(s)</span>
        <a asp-action="Create" class="btn btn-primary">Agregar producto</a>
    </div>

    @if (!Model.Any())
    {
        <p class="text-center text-muted my-5">Aún no hay productos registrados.</p>
    }

    <div class="grid-container">
        @foreach (var producto in Model)
        {
            @await Html.PartialAsync("_ProductCard", producto)
        }
    </div>
</div>
