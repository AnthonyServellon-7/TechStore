@model TechStore.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="card border-danger mx-auto my-4" style="max-width: 600px;">
    <div class="card-header bg-danger text-white">
        ¿Está seguro que desea eliminar este producto?
    </div>
    <div class="card-body">
        <dl class="row mb-3">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4">Descripción</dt>
            <dd class="col-sm-8">@Model.Descripcion</dd>

            <dt class="col-sm-4">Categoría</dt>
            <dd class="col-sm-8">@(Model.Categoria?.Nombre ?? "Sin categoría")</dd>

            <dt class="col-sm-4">Precio</dt>
            <dd class="col-sm-8">$@Model.Precio</dd>

            <dt class="col-sm-4">Stock</dt>
            <dd class="col-sm-8">@Model.Stock</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">@(Model.Estado ? "Disponible" : "Agotado")</dd>
        </dl>

        <p class="text-muted">Esta acción no se puede deshacer.</p>

        <form asp-action="Delete" asp-route-id="@Model.ID" method="post">
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
