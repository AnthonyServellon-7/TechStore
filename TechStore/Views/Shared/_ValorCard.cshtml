@model TechStore.Models.ValorCard

<div class="tech-card text-center d-flex flex-column align-items-center justify-content-center p-4">
    <div class="mb-3">
        <span class="fs-1">@Model.Icono</span>
    </div>
    <h3 class="h5 font-weight-bold" style="color: var(--primary-color);">@Model.Titulo</h3>
    <p class="text-muted small mb-0">@Model.Descripcion</p>
</div>
